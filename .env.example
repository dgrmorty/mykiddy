# ============== Клиент (Vite, сборка фронта) ==============
# Задаются при сборке: npm run build или в Railway/Vercel.

# URL бэкенда (API). В продакшене — ваш домен Railway.
# Если не задано, используется текущий origin (SPA и API на одном домене).
# VITE_API_URL=https://your-app.up.railway.app

# Основной публичный URL сайта для OAuth и canonical redirect.
# Если пользователи открывают Railway-ссылку, код перенесёт их на этот домен.
VITE_PUBLIC_APP_URL=https://detivtope.online

# Supabase (для клиента используется anon key — это нормально для RLS).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Список email админов через запятую. В продакшене обязательно задать!
# Без этой переменной в коде нет fallback — админов не будет.
VITE_ADMIN_EMAILS=admin@example.com

# ============== Сервер (Node, server.js) ==============
# Задаются в Railway / .env при запуске node server.js

PORT=8080

# Ключ Google Gemini API (обязательно для ИИ-тьютора и проверки ДЗ).
# Дублирующее имя (если в Railway завели GEMINI_API_KEY) — server.js читает оба.
API_KEY=your-gemini-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Supabase для сервера (проверка JWT, запись ai_usage).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role — только на сервере (Railway). Нужен для загрузки материалов к урокам админом.
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Лимиты ИИ в день на пользователя (опционально).
# AI_DAILY_TUTOR_LIMIT=25
# AI_DAILY_HOMEWORK_LIMIT=15

# Дополнительные CORS origins через запятую (если деплой на свой домен).
# CORS_ORIGIN=https://detivtope.ru,https://app.detivtope.ru

# ============== Bunny.net (защищённые видеоуроки) ==============
# Storage Zone + CDN с Token Authentication.
# BUNNY_STORAGE_ZONE_NAME=mykiddy-lessons
# BUNNY_STORAGE_PASSWORD=your-storage-zone-password
# BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
# BUNNY_CDN_HOSTNAME=mykiddy-cdn.b-cdn.net
# BUNNY_TOKEN_KEY=your-cdn-token-authentication-key
# Список админов для upload-auth (можно дублировать VITE_ADMIN_EMAILS)
# ADMIN_EMAILS=admin@example.com
